{
    "compilerOptions": {
        "target": "es5",
        "module": "none",
        "lib": [
            "dom",
            "es2015"
        ],
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "noImplicitAny": false,
        "removeComments": true,
        "preserveConstEnums": true
    },
    "include": [
        "src/**/*"
    ]
}