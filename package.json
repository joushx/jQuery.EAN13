{
  "name": "jquery-ean13",
  "version": "2.2.5",
  "description": "A JavaScript library for the generation of EAN13-barcodes",
  "repository": {
    "type": "git",
    "url": "https://github.com/joushx/jQuery.EAN13.git"
  },
  "keywords": [
    "ean13",
    "barcode",
    "jquery",
    "jquery-plugin",
    "ecosystem:jquery"
  ],
  "bugs": {
    "url": "https://github.com/joushx/jQuery.EAN13/issues",
    "email": "support@johannes-mittendorfer.com"
  },
  "license": "MIT",
  "author": {
    "name": "Johannes Mittendorfer",
    "email": "kontakt@johannes-mittendorfer.com",
    "url": "https://johannes-mittendorfer.com"
  },
  "main": "dist/ean13.js",
  "directories": {
    "example": "example"
  },
  "scripts": {
    "test": "npm run build && vitest run",
    "lint": "eslint src/**",
    "build": "tsc --outFile dist/ean13.js src/EAN13.ts src/index.ts --target es5 --lib es2015,dom && tsc --outFile dist/jquery-ean13.js src/EAN13.ts src/jquery-ean13.ts --target es5 --lib es2015,dom",
    "minify": "terser dist/ean13.js -o dist/ean13.min.js && terser dist/jquery-ean13.js -o dist/jquery-ean13.min.js",
    "prepublish": "npm run build && npm run minify"
  },
  "devDependencies": {
    "@types/jquery": "^3.5.33",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "@vitest/ui": "^4.0.16",
    "eslint": "^9.39.2",
    "jquery": "^3.7.1",
    "jsdom": "^27.3.0",
    "terser": "^5.44.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16",
    "vitest-canvas-mock": "^1.1.3"
  }
}
